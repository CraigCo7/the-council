# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...

# Per-role model overrides. Defaults:
# - Sonnet 4.6 for Chief of Staff routing (prompt caching activates at 2048
#   tokens; Haiku requires 4096 and so wouldn't cache — net result: Sonnet
#   with cache is cheaper than Haiku without, and routes better)
# - Sonnet 4.6 for daily briefs
# - Opus 4.7 with adaptive thinking for Strategic Analyst and weekly review
MODEL_ROUTINE=claude-sonnet-4-6
MODEL_BRIEF=claude-sonnet-4-6
MODEL_STRATEGIC=claude-opus-4-7

# ---------- Vault (Git) ----------
# Local path where the backend clones the vault repo.
VAULT_PATH=./vault
# GitHub remote of the private vault repo.
VAULT_REMOTE=git@github.com:CraigCo7/council-vault.git
VAULT_BRANCH=main
# Author for backend-made commits
VAULT_GIT_USER_NAME=The Council
VAULT_GIT_USER_EMAIL=council-bot@users.noreply.github.com

# ---------- Server ----------
HOST=0.0.0.0
PORT=8080
# Shared secret required on POST /message (send as Authorization: Bearer <token>)
INTAKE_TOKEN=change-me-to-a-long-random-string

# ---------- Operator profile ----------
OPERATOR_NAME=Craig
OPERATOR_TIMEZONE=Asia/Manila
PROJECTS=BidaWash,Puppery,ATIN,YNG,Personal

# ---------- Cron (cron syntax, local time) ----------
# 07:00 daily
CRON_DAILY_BRIEF=0 7 * * *
# Sunday 18:00
CRON_WEEKLY_REVIEW=0 18 * * 0
# Hourly deadline sweep
CRON_DEADLINE_SWEEP=0 * * * *
# 23:59 daily Anthropic cost summary (emitted to logs only)
CRON_DAILY_COST=59 23 * * *

# ---------- SQLite ----------
DB_PATH=./data/council.sqlite

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Telegram (preferred messenger) ----------
# Bot token from @BotFather (format: 123456789:AAH...). Required.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Numeric chat ID — only this chat is processed; everything else is dropped.
# To get it: send a message to your bot, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
TELEGRAM_CHAT_ID=
# Random string passed to setWebhook → Telegram echoes it back via the
# X-Telegram-Bot-Api-Secret-Token header. Generate with: openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=

# ---------- WhatsApp (parked — Meta restricted access for new portfolios) ----------
# Kept for optionality; set WHATSAPP_ENABLED=true if and when access is restored.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TO_NUMBER=
