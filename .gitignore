# dependencies
node_modules/
.pnpm-store/

# build — anchored at any depth is fine, "dist" isn't a valid source dir name
dist/
*.tsbuildinfo

# env + secrets
.env
.env.local
.env.*.local

# runtime state — anchored to repo root only (don't match src/data, src/logs)
/data/
/logs/
*.sqlite
*.sqlite-journal
*.log

# cloned vault (backend clones here at runtime). Match any dir named "vault"
# at any depth, but re-include the source-code directory so its .ts files
# stay tracked.
vault/
!apps/backend/src/vault/
!apps/backend/src/vault/**

# os
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# claude code local settings
.claude/settings.local.json
